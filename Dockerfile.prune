FROM rust:1.89-bookworm

RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the full ord repo
COPY . .

# Build and test prune crate
RUN cargo test -p prune --no-run

CMD ["cargo", "test", "-p", "prune", "--", "--nocapture"]
